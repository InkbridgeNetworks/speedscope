# callgrind format
events: Ir

# D is called by nine light callers (L1 to L9) and then by one heavy caller
# (HEAVY). L1 to L8 use up the expansion budget for D, so under L9 D shows
# as a leaf. HEAVY carries most of the profile, so D is still expanded under
# it even though the budget is used up.

fl=file.c
fn=A
1 0
cfn=L1
calls=1 1
1 11
